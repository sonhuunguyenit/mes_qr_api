{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    "development": {
      "developmentClient": false,
      "distribution": "store",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "NODE_ENV": "development"
      },
      "channel": "development"
    },
    "simulator-production": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "NODE_ENV": "production"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "NODE_ENV": "production"
      },
      "channel": "production"
    },
    "production-apk": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production"
      },
      "channel": "production"
    }
  },
  "submit": {
    "development": {},
    "production": {
      "ios": {
        "appleId": "apetechs.dev@gmail.com",
        "appleTeamId": "C8MY644AR6",
        "ascAppId": "6761249010"
      }
    }
  }
}
