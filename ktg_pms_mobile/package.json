{
  "name": "ktg-pms",
  "version": "1.0.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start:dev": "cross-env NODE_ENV=development npx expo start --dev-client -d",
    "start:pro": "cross-env NODE_ENV=production npx expo start --dev-client -d",
    "run:android:dev": "cross-env NODE_ENV=development npx expo run:android",
    "run:android:pro": "cross-env NODE_ENV=production npx expo run:android",
    "run:ios:dev": "cross-env NODE_ENV=development npx expo run:ios",
    "run:ios:pro": "cross-env NODE_ENV=production npx expo run:ios",
    "pre:ios:dev": "cross-env NODE_ENV=development npx expo prebuild --platform ios --clean",
    "pre:ios:pro": "cross-env NODE_ENV=production npx expo prebuild --platform ios --clean",
    "pre:android:dev": "cross-env NODE_ENV=development npx expo prebuild --platform android --clean",
    "pre:android:pro": "cross-env NODE_ENV=production npx expo prebuild --platform android --clean",
    "eas:android:dev": "cross-env NODE_ENV=development eas build --profile development --platform android --clear-cache --local",
    "eas:android:pro": "cross-env NODE_ENV=production eas build --profile production --platform android --clear-cache --local",
    "eas:android:pro:apk": "cross-env NODE_ENV=production eas build --profile production-apk --platform android --clear-cache",
    "eas:ios:dev:simulator": "eas build --profile simulator --platform ios --clear-cache",
    "eas:ios:prod:simulator": "eas build --profile simulator-production --platform ios --clear-cache",
    "eas:ios:dev": "cross-env NODE_ENV=development eas build --profile development --platform ios --clear-cache",
    "eas:ios:pro": "cross-env NODE_ENV=production eas build --profile production --platform ios --clear-cache",
    "submit:ios:dev": "cross-env NODE_ENV=development eas submit --platform ios --profile development",
    "submit:ios:pro": "cross-env NODE_ENV=production eas submit --platform ios --profile production",
    "update:dev": "cross-env NODE_ENV=development eas update --branch development",
    "update:pro": "cross-env NODE_ENV=production eas update --branch production"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "5.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/crashlytics": "^23.7.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/drawer": "^6.7.2",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@rneui/base": "4.0.0-rc.7",
    "@rneui/themed": "4.0.0-rc.7",
    "@shopify/flash-list": "1.7.6",
    "@tanstack/react-query": "^5.90.11",
    "axios": "1.6.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "expo": "~53.0.27",
    "expo-blur": "~14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-linear-gradient": "~14.1.5",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-updates": "~0.28.18",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "react": "19.0.0",
    "react-hook-form": "^7.66.1",
    "react-native": "0.79.6",
    "react-native-calendars": "^1.1313.0",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-webview": "13.13.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
